# ==============================================================================
# RocketBot Pro - Variables de Entorno de Configuración
# ==============================================================================

# Puerto y red de escucha del contenedor
PORT=8090
HOST=0.0.0.0
TZ=UTC

# Clave institucional para firma de tokens JWT (si se deja vacía, se autogenera y persiste en user_data/.jwt_secret)
JWT_SECRET=super_secret_jwt_institutional_key_min_32_characters_here

# Bloqueo de seguridad institucional: 0 = Siempre arrancar en Dry-Run Simulator (Recomendado)
ALLOW_STARTUP_LIVE=0

# Opcional: URL personalizada si usas microservicios separados
# VITE_API_URL=https://api.tu-dominio.com
# VITE_WS_URL=wss://api.tu-dominio.com/ws/stream

# Opcional: Claves de API de IA para el Copiloto Cuántico (Prof. Quant Alpha)
# (También se pueden ingresar directamente desde la interfaz web de forma segura)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Opcional: Alertas 24/7 automáticas
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
